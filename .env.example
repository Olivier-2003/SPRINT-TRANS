# Skopiuj ten plik do .env i uzupełnij wartości lokalnie.
# Ten plik (.env.example) jest wersjonowany w repo; .env NIE jest (patrz .gitignore).

# Połączenie z bazą PostgreSQL (lokalnie / Neon / Supabase).
# Na Supabase: DATABASE_URL to Transaction pooler (port 6543) — używany w runtime
# przez aplikację (dużo krótkotrwałych połączeń, np. serverless na Vercelu).
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/sprint_trans?schema=public"

# Na Supabase: DIRECT_URL to Session pooler / bezpośrednie połączenie (port 5432) —
# wymagane przez `prisma migrate` (DDL i prepared statements nie działają poprawnie
# przez pooler w trybie transaction). Poza migracjami nieużywane w runtime aplikacji.
DIRECT_URL=""

# Auth.js — sekret do podpisywania sesji. Wygeneruj lokalnie: `npx auth secret`
# (lub dowolny losowy ciąg 32+ znaków). Inny sekret na dev i na produkcji.
AUTH_SECRET=""

# OpenRouteService — liczenie dystansu trasy w kalkulatorze (Etap 4).
# Darmowy klucz: https://openrouteservice.org/dev/#/signup (limit ok. 2000 zapytań/dzień).
# Bez klucza kalkulator wyświetli klientowi czytelny komunikat o chwilowej niedostępności
# zamiast się wywalić — reszta aplikacji działa normalnie.
OPENROUTESERVICE_API_KEY=""

# Resend — wysyłka e-maili potwierdzających zapytanie (Etap 4).
# Darmowy klucz: https://resend.com (sign up, API Keys). Bez klucza zapytanie
# nadal zostanie zapisane w bazie — e-mail zostanie tylko pominięty (ostrzeżenie w logu).
RESEND_API_KEY=""
# Adres nadawcy e-maili. Bez własnej zweryfikowanej domeny w Resend można użyć
# domyślnego "onboarding@resend.dev" (działa tylko w trybie testowym Resend).
INQUIRY_FROM_EMAIL="onboarding@resend.dev"

# Kolejne zmienne (storage na zdjęcia) zostaną dodane w kolejnych etapach.

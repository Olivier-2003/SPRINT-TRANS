// Schemat bazy danych SPRINT-TRANS.
// Pełny opis modelu (uzasadnienie decyzji projektowych) w docs/plan.md, sekcja 3.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Konta panelu
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  calculatorSettingsUpdated CalculatorSettings[]
  priceQuotesCreated        PriceQuote[]
  bookingsCreated           Booking[]
  contactLogs               InquiryContactLog[]
  driverAvailabilityCreated DriverAvailability[]
  busAvailabilityCreated    BusAvailability[]
  assignmentHistoryChanges  BookingAssignmentHistory[]

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Kierowcy
// ---------------------------------------------------------------------------

enum DriverEmploymentStatus {
  ACTIVE
  INACTIVE
}

model Driver {
  id                String                 @id @default(cuid())
  firstName         String
  lastName          String
  phone             String
  email             String?
  licenseCategories String
  employmentStatus  DriverEmploymentStatus @default(ACTIVE)
  notes             String?
  /// Minimalny wymagany odpoczynek (w godzinach) pomiędzy końcem jednego zlecenia
  /// a początkiem kolejnego dla tego kierowcy. Domyślna wartość odpowiada typowej
  /// praktyce branżowej; edytowalna per kierowca. Używana przez silnik dostępności
  /// (lib/availability-engine.ts) do wykrywania statusu "problem z odpoczynkiem" —
  /// nie jest to twarda blokada, a ostrzeżenie do ręcznej weryfikacji administratora.
  restingHoursRequired Decimal  @default(11) @db.Decimal(4, 1)
  /// Orientacyjny maksymalny dzienny czas pracy (w godzinach) — informacyjnie, pod
  /// przyszły automatyczny algorytm przydziału (Etap 9). Nieegzekwowane twardo teraz.
  maxDailyWorkHours    Decimal? @db.Decimal(4, 1)
  /// Rodzaje zleceń, do których kierowca NIE powinien być przydzielany (np. brak
  /// uprawnień/preferencji). Generuje ostrzeżenie przy przypisaniu, nie blokuje.
  restrictedWorkTypes  InquiryType[] @default([])
  /// Rodzaje zleceń preferowane przez kierowcę — wyłącznie do sortowania rekomendacji
  /// w funkcji "Pokaż dostępnych kierowców", nie wpływa na status dostępności.
  preferredWorkTypes   InquiryType[] @default([])
  /// Docelowy miesięczny wymiar czasu pracy (godziny) — podstawa bilansu w ewidencji
  /// czasu pracy (lib/driver-timesheet.ts). Jeśli puste, używany jest wymiar tygodniowy
  /// przeliczony na miesiąc; jeśli oba puste, bilans/nadgodziny nie są wyliczane.
  monthlyWorkHoursNorm Decimal? @db.Decimal(6, 1)
  /// Docelowy tygodniowy wymiar czasu pracy (godziny) — używany do wyliczenia wymiaru
  /// miesięcznego, gdy monthlyWorkHoursNorm nie jest ustawione.
  weeklyWorkHoursNorm  Decimal? @db.Decimal(5, 1)
  createdAt         DateTime               @default(now())

  availability       DriverAvailability[]
  bookingAssignments BookingDriver[]
  lineAssignments    DriverLineAssignment[]

  @@map("drivers")
}

enum DriverAvailabilityType {
  URLOP
  CHOROBOWE
  SZKOLENIE
  NIEDOSTEPNY
  DOSTEPNY_CZESCIOWO
}

/// Ręcznie wprowadzana niedostępność (lub częściowa dostępność) kierowcy w danym
/// przedziale dat i godzin — obok zajętości wynikającej ze zleceń (Booking), to
/// drugie źródło danych brane pod uwagę przez silnik dostępności. Podstawa pod
/// przyszły automatyczny algorytm przydziału (Etap 9).
model DriverAvailability {
  id          String                 @id @default(cuid())
  driverId    String
  driver      Driver                 @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type        DriverAvailabilityType
  startAt     DateTime
  endAt       DateTime
  note        String?
  createdAt   DateTime               @default(now())
  createdById String?
  createdBy   AdminUser?             @relation(fields: [createdById], references: [id])

  @@index([driverId, startAt, endAt])
  @@map("driver_availability")
}

// ---------------------------------------------------------------------------
// Autobusy
// ---------------------------------------------------------------------------

enum BusStatus {
  ACTIVE
  SERVICE
  INACTIVE
}

model Bus {
  id                 String    @id @default(cuid())
  registrationNumber String    @unique
  brandModel         String
  seats              Int
  productionYear     Int?
  description        String?
  features           Json?
  status             BusStatus @default(ACTIVE)
  createdAt          DateTime  @default(now())

  photos             BusPhoto[]
  availability       BusAvailability[]
  bookingAssignments BookingBus[]

  @@map("buses")
}

model BusPhoto {
  id        String @id @default(cuid())
  busId     String
  bus       Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)

  @@index([busId, sortOrder])
  @@map("bus_photos")
}

enum BusAvailabilityType {
  DOSTEPNY
  SERWIS
  PRZEGLAD
  AWARIA
  NIEDOSTEPNY
}

/// Ręcznie wprowadzana niedostępność (lub jawna dostępność) autobusu w danym
/// przedziale dat i godzin — obok zajętości wynikającej ze zleceń (Booking), to
/// drugie źródło danych brane pod uwagę przez silnik dostępności. Podstawa pod
/// przyszły automatyczny algorytm przydziału (Etap 9).
model BusAvailability {
  id          String              @id @default(cuid())
  busId       String
  bus         Bus                 @relation(fields: [busId], references: [id], onDelete: Cascade)
  type        BusAvailabilityType
  startAt     DateTime
  endAt       DateTime
  note        String?
  createdAt   DateTime            @default(now())
  createdById String?
  createdBy   AdminUser?          @relation(fields: [createdById], references: [id])

  @@index([busId, startAt, endAt])
  @@map("bus_availability")
}

// ---------------------------------------------------------------------------
// Linie regularne
// ---------------------------------------------------------------------------

model RegularLine {
  id               String   @id @default(cuid())
  name             String
  originLabel      String
  destinationLabel String
  description      String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  stops             LineStop[]
  schedules         LineSchedule[]
  inquiries         Inquiry[]
  driverAssignments DriverLineAssignment[]

  @@map("regular_lines")
}

enum DriverLineRole {
  GLOWNY
  PREFEROWANY
  REZERWOWY
}

/// Trwałe przypisanie kierowcy do linii regularnej. Wejście do silnika rekomendacji
/// obsady (lib/driver-recommendation.ts) — podnosi ranking kierowcy przy sugestii
/// obsady zleceń powiązanych z daną linią. Nigdy nie tworzy automatycznego przydziału
/// do konkretnego zlecenia — o tym zawsze decyduje ręcznie administrator.
model DriverLineAssignment {
  id        String         @id @default(cuid())
  driverId  String
  driver    Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lineId    String
  line      RegularLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  role      DriverLineRole
  note      String?
  createdAt DateTime       @default(now())

  @@unique([driverId, lineId])
  @@map("driver_line_assignments")
}

model LineStop {
  id                   String      @id @default(cuid())
  lineId               String
  line                 RegularLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stopName             String
  sortOrder            Int
  arrivalOffsetMinutes Int

  @@index([lineId, sortOrder])
  @@map("line_stops")
}

/// Godziny kursów danej linii. daysOfWeek: 1 (poniedziałek) .. 7 (niedziela).
/// departureTime/arrivalTime w formacie "HH:MM" — rozkład tygodniowy, bez pełnej daty.
model LineSchedule {
  id            String      @id @default(cuid())
  lineId        String
  line          RegularLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  daysOfWeek    Int[]
  departureTime String
  arrivalTime   String
  price         Decimal     @db.Decimal(10, 2)
  validFrom     DateTime    @db.Date
  validTo       DateTime?   @db.Date

  @@index([lineId])
  @@map("line_schedules")
}

// ---------------------------------------------------------------------------
// Wycieczki
// ---------------------------------------------------------------------------

model Trip {
  id          String   @id @default(cuid())
  title       String
  description String?
  priceInfo   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  photos    TripPhoto[]
  inquiries Inquiry[]

  @@map("trips")
}

model TripPhoto {
  id        String @id @default(cuid())
  tripId    String
  trip      Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)

  @@index([tripId, sortOrder])
  @@map("trip_photos")
}

// ---------------------------------------------------------------------------
// Kalkulator
// ---------------------------------------------------------------------------

/// Bieżące stawki kalkulatora, edytowalne z panelu. Historyczne wyceny (PriceQuote)
/// przechowują własny snapshot stawek użytych w danym momencie i NIE są przeliczane
/// wstecz przy zmianie tej tabeli.
model CalculatorSettings {
  id                  String     @id @default(cuid())
  ratePerKm           Decimal    @db.Decimal(10, 2)
  baseFee             Decimal    @db.Decimal(10, 2)
  /// Stawka za godzinę postoju/oczekiwania kierowcy na miejscu.
  hourlyWaitingRate   Decimal    @default(0) @db.Decimal(10, 2)
  /// Koszt noclegu jednego kierowcy za jedną noc (wyjazdy wielodniowe).
  driverOvernightRate Decimal    @default(0) @db.Decimal(10, 2)
  /// Założona średnia prędkość przejazdu (km/h) — używana wyłącznie do
  /// orientacyjnego oszacowania czasu jazdy (i pośrednio czasu postoju)
  /// w automatycznej wycenie klienta. Dokładne reguły naliczania postoju
  /// administrator będzie mógł doprecyzować ręcznie per zapytanie.
  averageSpeedKmh     Decimal    @default(55) @db.Decimal(6, 2)
  updatedAt           DateTime   @updatedAt
  updatedById         String?
  updatedBy           AdminUser? @relation(fields: [updatedById], references: [id])

  @@map("calculator_settings")
}

/// Cache odpowiedzi z zewnętrznego API tras dla pary punktów — oszczędność limitu API.
model RouteDistanceCache {
  id              String   @id @default(cuid())
  originText      String
  destinationText String
  distanceKm      Decimal  @db.Decimal(10, 2)
  computedAt      DateTime @default(now())

  @@unique([originText, destinationText])
  @@map("route_distance_cache")
}

// ---------------------------------------------------------------------------
// Zapytanie ofertowe (niewiążące)
// ---------------------------------------------------------------------------

enum InquiryType {
  WYNAJEM
  WYCIECZKA
  LINIA_REGULARNA
  INNE
}

/// Workflow statusów zapytania. Kolejność logiczna (nieegzekwowana na poziomie
/// bazy): NOWE -> DO_KONTAKTU -> WYCENIONE -> OCZEKUJE_NA_KLIENTA -> ZAAKCEPTOWANE
/// | ODRZUCONE | ANULOWANE. Lista i etykiety PL scentralizowane w lib/inquiry-status.ts —
/// dodanie nowego statusu w przyszłości = nowa wartość enuma + wpis w tamtej mapie.
enum InquiryStatus {
  NOWE
  DO_KONTAKTU
  WYCENIONE
  OCZEKUJE_NA_KLIENTA
  ZAAKCEPTOWANE
  ODRZUCONE
  ANULOWANE
}

model Inquiry {
  id                   String        @id @default(cuid())
  type                 InquiryType
  customerName         String
  customerEmail        String
  customerPhone        String
  requestedDepartureAt DateTime
  requestedReturnAt    DateTime?
  passengerCount       Int
  additionalInfo       String?
  status               InquiryStatus @default(NOWE)

  relatedLineId String?
  relatedLine   RegularLine? @relation(fields: [relatedLineId], references: [id])
  relatedTripId String?
  relatedTrip   Trip?        @relation(fields: [relatedTripId], references: [id])

  routePoints RoutePoint[]
  priceQuotes PriceQuote[]
  contactLogs InquiryContactLog[]
  /// Ustawiane wyłącznie ręczną akcją administratora ("Utwórz zlecenie z zapytania").
  /// Nigdy nie tworzone automatycznie i nigdy przez klienta.
  booking     Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

/// Chronologiczna, append-only historia kontaktu z klientem — widoczna w szczegółach
/// zapytania. Wpisy nie są edytowane ani usuwane.
enum ContactType {
  PROBA_KONTAKTU
  ROZMOWA_TELEFONICZNA
  EMAIL
  BRAK_ODPOWIEDZI
  PROSBA_O_PONOWNY_KONTAKT
  USTALENIE_CENY
  AKCEPTACJA_KLIENTA
  NOTATKA
}

model InquiryContactLog {
  id          String      @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id])
  contactType ContactType
  note        String?
  createdAt   DateTime    @default(now())

  @@index([inquiryId, createdAt])
  @@map("inquiry_contact_logs")
}

enum RoutePointType {
  BAZA_WYJAZD
  ODBIOR
  PRZYSTANEK
  ZWROT
  BAZA_POWROT
}

/// Punkt trasy dla zapytania LUB zlecenia — dokładnie jedno z inquiryId/bookingId
/// powinno być ustawione. Ta reguła jest pilnowana w warstwie Server Actions
/// (lib/actions/), nie na poziomie bazy danych.
model RoutePoint {
  id        String         @id @default(cuid())
  inquiryId String?
  inquiry   Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sequence  Int
  pointType RoutePointType
  label     String
  lat       Decimal?       @db.Decimal(9, 6)
  lng       Decimal?       @db.Decimal(9, 6)

  @@index([inquiryId, sequence])
  @@index([bookingId, sequence])
  @@map("route_points")
}

/// Niemutowalny snapshot wyceny — append-only. calculatedPrice nigdy nie jest
/// nadpisywany; ręczna korekta admina tworzy NOWY rekord (manualPrice/manualDistanceKm)
/// i oznacza poprzedni jako isCurrent = false. Cena obowiązująca = manualPrice ?? calculatedPrice
/// najnowszego rekordu z isCurrent = true.
/// Niemutowalny snapshot wyceny (append-only, jak reszta wycen w systemie).
/// Uwzględnia nie tylko dystans, ale pełny czas i charakter realizacji zlecenia:
/// postój kierowcy, noclegi przy wyjazdach wielodniowych i liczbę kierowców.
/// Wszystkie stawki/parametry użyte do automatycznej kalkulacji są tu
/// skopiowane w momencie wyceny — zmiana CalculatorSettings później nie
/// wpływa na już złożone zapytania. Pola manualne (manualPrice, manualExtraCosts
/// itd.) pozwolą administratorowi (Etap 5) skorygować wycenę bez zmiany
/// automatycznie wyliczonych wartości.
model PriceQuote {
  id        String  @id @default(cuid())
  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  // --- Wejście automatycznej kalkulacji (snapshot stawek/parametrów) ---
  distanceKmAuto             Decimal? @db.Decimal(10, 2)
  ratePerKmAtQuote           Decimal  @db.Decimal(10, 2)
  baseFeeAtQuote             Decimal  @db.Decimal(10, 2)
  hourlyWaitingRateAtQuote   Decimal  @default(0) @db.Decimal(10, 2)
  driverOvernightRateAtQuote Decimal  @default(0) @db.Decimal(10, 2)
  averageSpeedKmhAtQuote     Decimal  @default(55) @db.Decimal(6, 2)
  /// Liczba dni wyjazdu (kalendarzowo, na podstawie dat wyjazdu/powrotu).
  tripDays                   Int      @default(1)
  /// Liczba noclegów kierowcy (tripDays - 1, jeśli > 0).
  overnightStays             Int      @default(0)
  /// Liczba kierowców uwzględniona w koszcie noclegów — domyślnie 1,
  /// administrator może zwiększyć przy dłuższych trasach.
  driverCount                Int      @default(1)
  /// Szacowany czas postoju/oczekiwania kierowcy na miejscu (w godzinach) —
  /// orientacyjny, wyliczony z różnicy czasu wyjazd/powrót i szacowanego
  /// czasu jazdy (dystans / averageSpeedKmhAtQuote).
  estimatedWaitingHours      Decimal  @default(0) @db.Decimal(6, 2)

  // --- Wyliczone składowe ceny (do przejrzystego podglądu w panelu) ---
  distanceCost  Decimal @default(0) @db.Decimal(10, 2)
  waitingCost   Decimal @default(0) @db.Decimal(10, 2)
  overnightCost Decimal @default(0) @db.Decimal(10, 2)

  // --- Ręczna korekta administratora (Etap 5) — puste w automatycznej wycenie
  //     klienta. Każda korekta to NOWY rekord PriceQuote (isCurrent=true na nowym,
  //     false na poprzednim) — powyższe pola automatyczne tego rekordu są wtedy
  //     kopiowane z poprzedniego "current" (nigdy nie przeliczane wstecz), a poniższe
  //     manualne pola niosą skorygowane przez administratora wartości. Efektywna
  //     wartość każdego składnika to zawsze "manualX ?? automatyczne pole".
  manualDistanceKm     Decimal? @db.Decimal(10, 2)
  manualTripDays       Int?
  manualOvernightStays Int?
  manualDriverCount    Int?
  manualWaitingHours   Decimal? @db.Decimal(6, 2)
  /// Dodatkowe koszty ręczne (np. opłaty drogowe, parking) — 0/puste w
  /// automatycznej wycenie klienta, uzupełniane przez administratora.
  manualExtraCosts     Decimal? @db.Decimal(10, 2)
  manualExtraCostsNote String?

  /// Suma automatyczna wszystkich składowych powyżej (baseFee + distanceCost +
  /// waitingCost + overnightCost). Nigdy nie nadpisywana.
  calculatedPrice Decimal    @db.Decimal(10, 2)
  /// Ostateczna cena po ręcznej korekcie administratora — nadrzędna nad
  /// calculatedPrice, jeśli ustawiona.
  manualPrice     Decimal?   @db.Decimal(10, 2)
  isCurrent       Boolean    @default(true)
  createdAt       DateTime   @default(now())
  createdById     String?
  createdBy       AdminUser? @relation(fields: [createdById], references: [id])
  note            String?

  @@index([inquiryId, isCurrent])
  @@map("price_quotes")
}

// ---------------------------------------------------------------------------
// Zlecenie / przejazd (wyłącznie ręcznie, po akceptacji zapytania)
// ---------------------------------------------------------------------------

enum BookingStatus {
  ZAPLANOWANE
  W_TRAKCIE
  ZAKONCZONE
  ANULOWANE
}

model Booking {
  id              String        @id @default(cuid())
  sourceInquiryId String        @unique
  sourceInquiry   Inquiry       @relation(fields: [sourceInquiryId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String
  startAt         DateTime
  endAt           DateTime
  finalPrice      Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(ZAPLANOWANE)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  createdBy       AdminUser?    @relation(fields: [createdById], references: [id])

  routePoints      RoutePoint[]
  drivers          BookingDriver[]
  buses            BookingBus[]
  assignmentHistory BookingAssignmentHistory[]

  @@index([startAt, endAt])
  @@index([status])
  @@map("bookings")
}

enum BookingDriverRole {
  GLOWNY
  POMOCNICZY
}

/// Wielu kierowców na jedno zlecenie.
model BookingDriver {
  id         String             @id @default(cuid())
  bookingId  String
  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver             @relation(fields: [driverId], references: [id])
  roleOnTrip BookingDriverRole?

  @@unique([bookingId, driverId])
  @@map("booking_drivers")
}

/// Wiele autobusów na jedno zlecenie.
model BookingBus {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  busId     String
  bus       Bus     @relation(fields: [busId], references: [id])

  @@unique([bookingId, busId])
  @@map("booking_buses")
}

enum AssignmentResourceType {
  KIEROWCA
  AUTOBUS
}

enum AssignmentChangeType {
  PRZYPISANO
  ZMIENIONO
  USUNIETO
}

/// Append-only historia zmian obsady zlecenia (przypisanie / zmiana / usunięcie
/// kierowcy lub autobusu). Niezależna od aktualnego stanu BookingDriver/BookingBus —
/// resourceLabel jest migawką nazwy w momencie zmiany, więc historia pozostaje
/// czytelna nawet po usunięciu danego kierowcy/autobusu z bazy. Zawsze efekt
/// świadomej, ręcznej decyzji administratora — nigdy zapisu automatycznego algorytmu.
model BookingAssignmentHistory {
  id            String                  @id @default(cuid())
  bookingId     String
  booking       Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceType  AssignmentResourceType
  resourceId    String
  resourceLabel String
  changeType    AssignmentChangeType
  note          String?
  changedAt     DateTime                @default(now())
  changedById   String?
  changedBy     AdminUser?              @relation(fields: [changedById], references: [id])

  @@index([bookingId, changedAt])
  @@map("booking_assignment_history")
}
